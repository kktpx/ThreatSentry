# ThreatSentry Backend Environment Configuration
APP_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=http://localhost:3000
MODEL_PATH=ml/models/web_ids_model_v1.0.0.joblib

# Scanner Resource & Concurrency Controls
SCANNER_MAX_PAGES=30
SCANNER_MAX_DEPTH=3
SCANNER_CONCURRENCY=5
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=2097152
SCANNER_REQUEST_TIMEOUT_SECONDS=10
SCANNER_MAX_SCAN_SECONDS=1200

# Local Testing Boundary (Permits loopback target http://localhost:8080 during development only)
# STRICTLY FORBIDDEN (raises ValueError) when APP_ENV=production
SCAN_ALLOW_LOCAL=true
